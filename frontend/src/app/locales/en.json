    },
    "hero": {
      "badge": "Open alpha",
      "title": "Production-ready Flask,",
      "accent": "thoughtfully minimal",
      "lead": "Minimals is a batteries-included Flask service for cPanel and VPS behind Caddy — layered domain architecture, session & API-key auth, and a Vue 3 SPA served by Flask itself.",
      "lifecycle": "request lifecycle",
      "ok": "200 OK"
    },
    "features": {
      "badge": "Features",
      "title": "Everything you'd build anyway",
      "lead": "The production floor every Flask service needs — included, tested, and deliberately unexciting.",
      "items": {
        "layered": {
          "title": "Layered domains",
          "desc": "Seven files per domain, dependencies pointing only downward. A bug has exactly one address."
        },
        "auth": {
          "title": "Session & API-key auth",
          "desc": "Browser sessions via Flask-Login; services authenticate with bcrypt-hashed API keys behind a 10-char lookup prefix."
        },
        "security": {
          "title": "Security defaults",
          "desc": "CSRF on every write, per-IP rate limits, CSP + HSTS, and forwarded headers believed only from private peers."
        },
        "roles": {
          "title": "Roles & RBAC",
          "desc": "A hard-coded app role for real checks, relational roles for labels, and require_role helpers that return."
        },
        "setup": {
          "title": "First-run setup",
          "desc": "SQLite, MariaDB or PostgreSQL: test, migrate, create the admin — the engine hot-swaps, loopback-only."
        },
        "health": {
          "title": "Health & audit",
          "desc": "/health and /ready probes, rotating logs, an audit trail per write, and alerts that never break the business flow."
        },
        "spa": {
          "title": "Vue 3 SPA included",
          "desc": "frappe-ui on Tailwind tokens, built straight into Flask's static folder. One process, one origin, one deploy."
        },
        "migrations": {
          "title": "Migrations on boot",
          "desc": "Flip MIGRATE_ON_BOOT and Alembic runs before the server accepts traffic — schema and models stay in step across engines."
        }
      }
    },
    "about": {
      "badge": "About",
      "title": "Minimal, not trivial.",
      "body1": "Minimals started from an observation: every production Flask service re-implements the same scaffolding — auth, CSRF, roles, migrations, health checks, a frontend build. Minimals packages that floor, and nothing above it.",
      "body2": "The architecture is deliberately boring. Services own transactions, repositories own queries, and the wire format is a tested contract. When something breaks, you fix it at the point of failure — there is no history to dig through.",
      "rules": "House rules",
      "principles": {
        "p1": "Dependencies point only downward — api, dto, services, repositories, models, presenters.",
        "p2": "Services own the transaction; repositories never commit.",
        "p3": "Bare objects on success, a single snake_case key on failure.",
        "p4": "Raise exceptions from services — never return responses.",
        "p5": "Fix at the point of failure. No history to dig through."
      }
    },
    "cta": {
      "title": "Start where the boring parts are already done.",
      "lead": "Run setup once — point at your database, create the admin — then ship your domain on a floor that's ready."
    },
    "footer": {
      "alpha": "open alpha",
      "copyright": "© 2026 {name}"
    }
  },
