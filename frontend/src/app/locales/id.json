    "hero": {
      "badge": "Alpha terbuka",
      "title": "Flask siap produksi,",
      "accent": "dengan rasa minimal",
      "lead": "Minimals adalah layanan Flask yang lengkap untuk cPanel dan VPS di belakang Caddy — arsitektur domain berlapis, autentikasi sesi & API-key, dan SPA Vue 3 yang disajikan oleh Flask sendiri.",
      "lifecycle": "siklus request",
      "ok": "200 OK"
    },
    "features": {
      "badge": "Fitur",
      "title": "Semua yang tetap akan Anda bangun",
      "lead": "Panggung produksi yang dibutuhkan setiap layanan Flask — sudah tersedia, sudah diuji, dan sengaja dibuat biasa.",
      "items": {
        "layered": {
          "title": "Domain berlapis",
          "desc": "Tujuh berkas per domain, dependensi hanya menunjuk ke bawah. Sebuah bug punya tepat satu alamat."
        },
        "auth": {
          "title": "Autentikasi sesi & API-key",
          "desc": "Sesi peramban lewat Flask-Login; layanan mengautentikasi dengan API key ber-hash bcrypt di belakang prefiks lookup 10 karakter."
        },
        "security": {
          "title": "Keamanan bawaan",
          "desc": "CSRF di setiap operasi tulis, rate limit per IP, CSP + HSTS, dan header forwarded yang hanya dipercaya dari peer privat."
        },
        "roles": {
          "title": "Peran & RBAC",
          "desc": "App role keras untuk pemeriksaan nyata, peran relasional untuk label, dan helper require_role yang langsung return."
        },
        "setup": {
          "title": "Setup awal",
          "desc": "SQLite, MariaDB, atau PostgreSQL: uji, migrasi, buat admin — mesinnya bisa ditukar, hanya dari loopback."
        },
        "health": {
          "title": "Kesehatan & audit",
          "desc": "Probe /health dan /ready, log berputar, jejak audit per operasi tulis, dan alert yang tidak pernah mengganggu alur bisnis."
        },
        "spa": {
          "title": "SPA Vue 3 ikut disertakan",
          "desc": "frappe-ui di atas token Tailwind, dibangun langsung ke folder static Flask. Satu proses, satu origin, satu deploy."
        },
        "migrations": {
          "title": "Migrasi saat boot",
          "desc": "Nyalakan MIGRATE_ON_BOOT dan Alembic berjalan sebelum server menerima trafik — skema dan model tetap sinkron di semua mesin."
        }
      }
    },
    "about": {
      "badge": "Tentang",
      "title": "Minimal, bukan sepele.",
      "body1": "Minimals lahir dari satu pengamatan: setiap layanan Flask produksi mengulang scaffolding yang sama — autentikasi, CSRF, peran, migrasi, health check, dan build frontend. Minimals membungkus lantai dasar itu, dan tidak lebih.",
      "body2": "Arsitekturnya sengaja membosankan. Service memiliki transaksi, repository memiliki query, dan format wire adalah kontrak yang diuji. Saat ada yang rusak, Anda memperbaikinya di titik masalah — tidak ada riwayat yang perlu digali.",
      "rules": "Aturan rumah",
      "principles": {
        "p1": "Dependensi hanya menunjuk ke bawah — api, dto, services, repositories, models, presenters.",
        "p2": "Service memiliki transaksi; repository tidak pernah commit.",
        "p3": "Objek telanjang saat sukses, satu kunci snake_case saat gagal.",
        "p4": "Raise exception dari service — jangan pernah return response.",
        "p5": "Perbaiki di titik masalah. Tidak ada riwayat yang perlu digali."
      }
    },
    "cta": {
      "title": "Mulai dari bagian membosankan yang sudah selesai.",
      "lead": "Jalankan setup sekali — tunjuk ke basis data Anda, buat admin — lalu kirim domain Anda di atas lantai yang sudah siap."
    },
    "footer": {
      "alpha": "alpha terbuka",
      "copyright": "© 2026 {name}"
    }
  },
